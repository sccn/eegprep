          "type": "command",
          "action": "open_menu:Help",
          "command": [
            "{python}",
            "-m",
            "eegprep.functions.guifunc.visual_capture",
            "--case",
            "{case_id}",
            "--output",
            "{output}"
          ]
        }
      }
    }
  ]
}
